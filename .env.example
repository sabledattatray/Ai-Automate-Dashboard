# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# Firebase Client (Prefix with VITE_ for frontend)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# Firebase Admin (Secret for backend)
# You can set individual properties or provide a service account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id": "...", "private_key": "...", "client_email": "...", ...}'

# APP_URL: The URL where this app is hosted.
APP_URL="https://your-app.vercel.app"
