rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Check if user is the known admin by email
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sabledattatray@gmail.com' && request.auth.token.email_verified == true;
    }

    // --- Validation Blueprints ---
    
    function isValidDataset(data) {
      return data.keys().hasAll(['id', 'name', 'columns', 'data'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.columns is list && data.columns.size() <= 200
        && data.data is list && data.data.size() <= 10000;
    }

    function isValidDashboard(data) {
      return data.keys().hasAll(['tiles'])
        && data.tiles is list && data.tiles.size() <= 200;
    }

    // --- Collection Routes ---

    match /users/{userId} {
      // Basic profile or path access
      allow get: if isOwner(userId) || isAdmin();
      
      match /datasets/{datasetId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();
        
        allow create: if isOwner(userId) 
          && isValidId(datasetId) 
          && isValidDataset(request.resource.data)
          && request.resource.data.id == datasetId;

        allow update: if isOwner(userId)
          && isValidDataset(request.resource.data)
          && request.resource.data.id == resource.data.id;

        allow delete: if isOwner(userId);
      }

      match /dashboards/{dashboardId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && isValidId(dashboardId)
          && isValidDashboard(request.resource.data);

        allow update: if isOwner(userId)
          && isValidDashboard(request.resource.data);

        allow delete: if isOwner(userId);
      }
    }
  }
}
