{
  "entities": {
    "Dataset": {
      "title": "Dataset",
      "description": "Metadata and sample data for a user's dataset.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "columns": { "type": "array" },
        "data": { "type": "array" },
        "size": { "type": "number" },
        "lastModified": { "type": "number" }
      },
      "required": ["userId", "name"]
    },
    "Dashboard": {
      "title": "Dashboard",
      "description": "Stored layout and configuration of a user dashboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tiles": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "tiles"]
    }
  },
  "firestore": {
    "users/{userId}/datasets/{datasetId}": {
      "schema": "Dataset",
      "description": "User-specific datasets."
    },
    "users/{userId}/dashboards/{dashboardId}": {
      "schema": "Dashboard",
      "description": "User-specific dashboard layouts."
    }
  }
}
